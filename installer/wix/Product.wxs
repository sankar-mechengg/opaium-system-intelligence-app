<?xml version="1.0" encoding="UTF-8"?>
<!--
  OP(AI)UM — WiX MSI wrapper for PyInstaller onedir output.
  Harvest.wxs is generated by heat.exe against dist/OPAIUM.
  Variables: HarvestSource (absolute path), ProductVersion (e.g. 1.0.0.0).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="OP(AI)UM"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="Veyon Ideations Pvt Ltd"
      UpgradeCode="8F3C2B1A-7E6D-49F0-8A5C-123456789ABC">

    <Package
        InstallerVersion="200"
        Compressed="yes"
        InstallScope="perMachine"
        InstallPrivileges="elevated"
        Description="OP(AI)UM Windows Installer"
        Comments="Installed from PyInstaller build"
        Manufacturer="Veyon Ideations Pvt Ltd" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="OP(AI)UM" Level="1">
      <ComponentGroupRef Id="OPAIUMComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Product>

  <!-- Install directory + all-users Start Menu folder (perMachine) -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="OPAIUM" />
      </Directory>
      <Directory Id="CommonProgramsFolder">
        <Directory Id="ApplicationProgramsFolder" Name="OP(AI)UM" />
      </Directory>
    </Directory>
  </Fragment>

  <!-- Start menu shortcut (exe comes from heat-generated components) -->
  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut
            Id="StartMenuShortcut"
            Name="OP(AI)UM"
            Description="OP(AI)UM"
            Target="[INSTALLFOLDER]OPAIUM.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanupShortCutFolder" On="uninstall" />
        <RegistryValue
            Root="HKLM"
            Key="Software\VeyonIdeations\OPAIUM"
            Name="InstallerShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
