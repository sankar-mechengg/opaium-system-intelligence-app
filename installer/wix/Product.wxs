<?xml version="1.0" encoding="UTF-8"?>
<!--
  OP(AI)UM — WiX MSI wrapper for PyInstaller onedir output.
  Harvest.wxs is generated by heat.exe against dist/OPAIUM.
  Variables: HarvestSource (absolute path), ProductVersion (e.g. 1.0.0.0).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="OP(AI)UM"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="Sankar Balasubramanian"
      UpgradeCode="8F3C2B1A-7E6D-49F0-8A5C-123456789ABC">

    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        InstallPrivileges="elevated"
        Platform="x64"
        Description="OP(AI)UM Windows Installer"
        Comments="Installed from PyInstaller build"
        Manufacturer="Sankar Balasubramanian" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!--
      Force CommonProgramsFolder / DesktopFolder to the correct all-users paths.
      Under the SYSTEM account the MSI service may resolve these to C:\ instead.
    -->
    <SetDirectory Id="CommonProgramsFolder" Value="[CommonAppDataFolder]Microsoft\Windows\Start Menu\Programs" />
    <SetDirectory Id="DesktopFolder" Value="[WindowsVolume]Users\Public\Desktop" />

    <!-- License acceptance UI (WixUI_Minimal shows a single license page) -->
    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <Feature Id="ProductFeature" Title="OPAIUM" Level="1">
      <ComponentGroupRef Id="OPAIUMComponents" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="OPAIUM" />
      </Directory>
      <Directory Id="CommonProgramsFolder">
        <Directory Id="ApplicationProgramsFolder" Name="OPAIUM" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>
  </Fragment>

  <!-- Start Menu shortcut -->
  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcutComponent" Guid="A1B2C3D4-E5F6-7890-ABCD-111111111111">
        <Shortcut
            Id="StartMenuShortcut"
            Name="OPAIUM"
            Description="OPAIUM System Intelligence"
            Target="[INSTALLFOLDER]OPAIUM.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanupStartMenuFolder" On="uninstall" />
        <RegistryValue
            Root="HKLM"
            Key="Software\SankarBalasubramanian\OPAIUM"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- Desktop shortcut -->
  <Fragment>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="A1B2C3D4-E5F6-7890-ABCD-222222222222">
        <Shortcut
            Id="DesktopShortcut"
            Name="OPAIUM"
            Description="OPAIUM System Intelligence"
            Target="[INSTALLFOLDER]OPAIUM.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\SankarBalasubramanian\OPAIUM"
            Name="DesktopShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
