# OP(AI)UM environment variables (optional — the app is normally configured from Settings)
# Copy this file to .env for development; it is loaded from the project root when not frozen.

# Fallback OpenAI API key used only when no key is saved in Settings.
OPENAI_API_KEY=

# Log level: DEBUG, INFO, WARNING, ERROR (also: --log-level on the command line)
OPAIUM_LOG_LEVEL=INFO
