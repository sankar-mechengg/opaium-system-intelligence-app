# OP(AI)UM Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required for AI features)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Default AI Model
OPAIUM_AI_MODEL=gpt-5.2-2025-12-11

# Default Transcription Model (gpt-4o-transcribe or whisper-1)
OPAIUM_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Log Level (DEBUG, INFO, WARNING, ERROR)
OPAIUM_LOG_LEVEL=INFO

# Auto-refresh interval in seconds (default: 300 = 5 minutes)
OPAIUM_REFRESH_INTERVAL=300

# Undo history auto-purge days (default: 2)
OPAIUM_UNDO_PURGE_DAYS=2
