/*
 * OP(AI)UM — Light Theme (Pastel)
 * Soft pastels with blue accents
 */

/* === Global === */
QWidget {
    background-color: #F8F9FA;
    color: #333333;
    font-family: "Segoe UI", system-ui, sans-serif;
}

QWidget:disabled {
    color: #AAAAAA;
}

/* === Main Central === */
#mainCentral {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 10px;
}

/* === Title Bar === */
#titleBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E9ECEF;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

#titleAppName {
    color: #2C3E50;
}

#titleTab {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 14px;
    color: #6C757D;
}

#titleTab:checked {
    background-color: #E3F2FD;
    color: #1976D2;
    font-weight: bold;
}

#titleTab:hover:!checked {
    background-color: #F1F3F5;
}

#titleSettingsBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #6C757D;
}

#titleSettingsBtn:hover {
    background-color: #F1F3F5;
}

#titleMinBtn, #titleMaxBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #6C757D;
}

#titleMinBtn:hover, #titleMaxBtn:hover {
    background-color: #E9ECEF;
}

#titleCloseBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #6C757D;
}

#titleCloseBtn:hover {
    background-color: #F44336;
    color: white;
}

/* === Search Bar === */
#searchInput {
    background-color: #FFFFFF;
    border: 1.5px solid #DEE2E6;
    border-radius: 8px;
    padding: 6px 12px;
    color: #333333;
    selection-background-color: #90CAF9;
}

#searchInput:focus {
    border-color: #4FC3F7;
}

#typeFilter {
    background-color: #FFFFFF;
    border: 1.5px solid #DEE2E6;
    border-radius: 8px;
    padding: 4px 8px;
    color: #333333;
}

#refreshBtn {
    background-color: #E3F2FD;
    border: none;
    border-radius: 8px;
    color: #1976D2;
    padding: 4px 12px;
    font-weight: bold;
}

#refreshBtn:hover {
    background-color: #BBDEFB;
}

/* === Explorer Splitter === */
#explorerSplitter::handle {
    background-color: #E9ECEF;
}

/* === Tree View === */
#treeHeader {
    background-color: #FFFFFF;
    border: none;
    color: #2C3E50;
}

#folderTree {
    background-color: #FFFFFF;
    border: none;
    color: #333333;
}

#folderTree::item {
    padding: 4px 2px;
    border-radius: 4px;
}

#folderTree::item:selected {
    background-color: #E3F2FD;
    color: #1976D2;
}

#folderTree::item:hover:!selected {
    background-color: #F5F5F5;
}

/* === Card Grid === */
#cardGridScroll {
    background-color: #F8F9FA;
    border: none;
}

/* === Folder Card === */
#folderCard {
    background-color: #FFFFFF;
    border: none;
    border-radius: 10px;
}

#folderCard:hover {
    background-color: #FAFCFF;
}

#folderCard[selected="true"] {
    background-color: #E3F2FD;
}

#folderCardName {
    color: #2C3E50;
}

#folderCardCount, #folderCardTime {
    color: #868E96;
}

#folderCardBroken {
    color: #E57373;
}

/* === File Card === */
#fileCard {
    background-color: #FFFFFF;
    border: none;
    border-radius: 10px;
}

#fileCard:hover {
    background-color: #FAFFF9;
}

#fileCard[selected="true"] {
    background-color: #E8F5E9;
}

#fileCardName {
    color: #2C3E50;
}

#fileCardExt {
    color: #4FC3F7;
}

#fileCardSize, #fileCardTime {
    color: #868E96;
}

/* === Collapsible Section === */
#collapsibleHeader {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

#collapsibleHeader:hover {
    background-color: #F1F3F5;
}

#collapsibleTitle {
    color: #495057;
}

#collapsibleArrow {
    color: #ADB5BD;
}

#collapsibleCount {
    background-color: #E3F2FD;
    color: #1976D2;
    border-radius: 11px;
}

/* === Group Header === */
#groupHeaderTitle {
    color: #495057;
}

#groupHeaderCount {
    color: #ADB5BD;
}

#groupHeaderArrow {
    color: #CED4DA;
}

/* === Preview Panel === */
#previewPanel {
    background-color: #FFFFFF;
    border-left: 1px solid #E9ECEF;
}

#previewHeader {
    color: #2C3E50;
}

#previewSeparator {
    color: #E9ECEF;
}

#previewName {
    color: #2C3E50;
}

#previewLabel {
    color: #ADB5BD;
}

#previewValue {
    color: #495057;
}

#previewEmpty {
    color: #CED4DA;
}

/* === Chat === */
#chatHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E9ECEF;
    color: #2C3E50;
}

#chatScroll {
    background-color: #F8F9FA;
}

#bubble_user {
    background-color: rgba(79, 195, 247, 0.12);
    border: 1px solid rgba(79, 195, 247, 0.3);
    border-radius: 14px 14px 4px 14px;
    padding: 4px;
    min-width: 80px;
}

#bubbleContent_user {
    color: #1565C0;
    background: transparent;
}

#bubble_assistant {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 14px 14px 14px 4px;
    padding: 4px;
    min-width: 80px;
}

#bubbleContent_assistant {
    color: #333333;
    background: transparent;
}

#bubble_system {
    background-color: rgba(255, 224, 130, 0.15);
    border: 1px solid rgba(255, 224, 130, 0.4);
    border-radius: 10px;
    padding: 4px;
}

#bubbleContent_system {
    color: #795548;
    background: transparent;
}

#bubbleRole {
    color: #4FC3F7;
    background: transparent;
}

#bubbleTime_assistant, #bubbleTime_system {
    color: #ADB5BD;
    background: transparent;
}

#bubbleTime_user {
    color: rgba(79, 195, 247, 0.6);
    background: transparent;
}

/* === Chat Context Card === */
#chatContextCard {
    background: transparent;
}

#contextCardInner {
    background-color: rgba(79, 195, 247, 0.06);
    border: 1px solid rgba(79, 195, 247, 0.2);
    border-radius: 8px;
    padding: 2px;
}

#contextCardName {
    color: #333333;
    background: transparent;
}

#contextCardPath {
    color: #9E9E9E;
    background: transparent;
}

#contextCardType {
    color: #1565C0;
    background-color: rgba(79, 195, 247, 0.1);
    border-radius: 4px;
    padding: 2px 6px;
}

#contextCardIcon {
    background: transparent;
}

/* === Conversations Sidebar === */
#convSidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E9ECEF;
}

#convSidebarHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E9ECEF;
}

#convSidebarTitle {
    color: #2C3E50;
}

#convNewBtn {
    background-color: #E3F2FD;
    border: none;
    border-radius: 14px;
    color: #1976D2;
}

#convNewBtn:hover {
    background-color: #BBDEFB;
}

#convSidebarScroll {
    background-color: #FFFFFF;
}

#convItem {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 2px;
}

#convItem:hover {
    background-color: #F1F3F5;
}

#convItem[selected="true"] {
    background-color: #E3F2FD;
}

#convItemTitle {
    color: #2C3E50;
    background: transparent;
}

#convItemFolder {
    color: #868E96;
    background: transparent;
}

#convItemTime {
    color: #ADB5BD;
    background: transparent;
}

#convEmptyLabel {
    color: #CED4DA;
}

#convSeparator {
    color: #E9ECEF;
}

/* === Markdown Browser === */
#markdownBrowser {
    background: transparent;
    border: none;
    color: #333333;
}

/* === Chat Input === */
#chatInput {
    background-color: #FFFFFF;
    border: 1.5px solid #DEE2E6;
    border-radius: 10px;
    padding: 8px;
    color: #333333;
}

#chatInput:focus {
    border-color: #4FC3F7;
}

#sendButton {
    background-color: #4FC3F7;
    border: none;
    border-radius: 10px;
    color: white;
    font-weight: bold;
}

#sendButton:hover {
    background-color: #29B6F6;
}

#sendButton:disabled {
    background-color: #B0BEC5;
}

#micButton {
    background-color: #F1F3F5;
    border: 1.5px solid #DEE2E6;
    border-radius: 21px;
}

#micButton:hover {
    background-color: #E9ECEF;
}

#micButtonActive {
    background-color: #FFCDD2;
    border: 2px solid #EF5350;
    border-radius: 21px;
}

/* === Quick Action Chips === */
#actionChip {
    background-color: #E3F2FD;
    border: 1px solid #BBDEFB;
    border-radius: 14px;
    padding: 2px 10px;
    color: #1976D2;
}

#actionChip:hover {
    background-color: #BBDEFB;
}

/* === Tool Result === */
#toolResult {
    background-color: #F1F8E9;
    border: 1px solid #C5E1A5;
    border-radius: 10px;
    margin: 4px 8px;
}

#toolResultName {
    color: #33691E;
}

#toolResultStatus_ok {
    color: #4CAF50;
}

#toolResultStatus_err {
    color: #F44336;
}

#toolResultMessage {
    color: #555555;
}

#toolResultSummary {
    color: #888888;
}

#toolResultUndoBtn {
    background-color: #FFF3E0;
    border: 1px solid #FFE0B2;
    border-radius: 6px;
    color: #E65100;
    padding: 2px 8px;
}

#toolResultUndoBtn:hover {
    background-color: #FFE0B2;
}

/* === Typing Indicator === */
#typingLabel {
    color: #ADB5BD;
}

/* === History === */
#historyTitle {
    color: #2C3E50;
}

#historyCount {
    color: #ADB5BD;
}

#historyRow {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 8px;
}

#historyRow:hover {
    background-color: #F8F9FA;
}

#historyDesc {
    color: #333333;
}

#historyMeta {
    color: #ADB5BD;
}

#historyUndone {
    color: #ADB5BD;
}

#historyUndoBtn {
    background-color: #FFF3E0;
    border: 1px solid #FFE0B2;
    border-radius: 6px;
    color: #E65100;
}

#historyUndoBtn:hover {
    background-color: #FFE0B2;
}

#historyEmpty {
    color: #CED4DA;
}

/* === Approval Dialog === */
#approvalHeader {
    color: #E65100;
}

#approvalPreview {
    background-color: #F5F5F5;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    color: #333333;
    font-family: "Cascadia Code", "Consolas", monospace;
}

#approvalWarning {
    color: #E65100;
}

#approvalRejectBtn {
    background-color: #F5F5F5;
    border: 1px solid #BDBDBD;
    border-radius: 8px;
    color: #616161;
}

#approvalApproveBtn {
    background-color: #4CAF50;
    border: none;
    border-radius: 8px;
    color: white;
}

#approvalApproveBtn:hover {
    background-color: #43A047;
}

/* === Settings === */
#settingsGroup {
    border: 1px solid #E9ECEF;
    border-radius: 8px;
    padding: 12px;
    margin-top: 8px;
}

#settingsGroup::title {
    color: #495057;
    font-weight: bold;
}

#settingsNote {
    color: #ADB5BD;
}

#settingsError {
    color: #F44336;
}

#settingsSaveBtn {
    background-color: #4FC3F7;
    border: none;
    border-radius: 8px;
    color: white;
}

#settingsSaveBtn:hover {
    background-color: #29B6F6;
}

/* === Auth Screen === */
#authAppName {
    color: #2C3E50;
}

#authSubtitle {
    color: #ADB5BD;
}

#setupFullName {
    color: #868E96;
}

#authSeparator {
    color: #E9ECEF;
}

#authInstruction {
    color: #495057;
}

#authInput {
    background-color: #FFFFFF;
    border: 2px solid #DEE2E6;
    border-radius: 10px;
    padding: 8px;
    color: #333333;
}

#authInput:focus {
    border-color: #4FC3F7;
}

#authError {
    color: #F44336;
}

#authUnlockBtn {
    background-color: #4FC3F7;
    border: none;
    border-radius: 10px;
    color: white;
}

#authUnlockBtn:hover {
    background-color: #29B6F6;
}

#authAttempts {
    color: #ADB5BD;
}

/* === Context Menu === */
#contextMenu {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    padding: 4px;
}

#contextMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}

#contextMenu::item:selected {
    background-color: #E3F2FD;
    color: #1976D2;
}

/* === Scrollbars === */
QScrollBar:vertical {
    background: #F1F3F5;
    width: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #ADB5BD;
    border-radius: 6px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: #1976D2;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #F1F3F5;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #ADB5BD;
    border-radius: 6px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: #1976D2;
}

/* === Tooltips === */
QToolTip {
    background-color: #37474F;
    color: #ECEFF1;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 9pt;
}

/* === Combo Box Dropdown === */
QComboBox {
    border-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    selection-background-color: #E3F2FD;
    selection-color: #1976D2;
}

/* === Spin Box === */
QSpinBox {
    background-color: #FFFFFF;
    border: 1.5px solid #DEE2E6;
    border-radius: 8px;
    padding: 4px 8px;
}

QSpinBox:focus {
    border-color: #4FC3F7;
}

/* === Tab Widget === */
#settingsTabs::pane {
    border: 1px solid #E9ECEF;
    border-radius: 8px;
    background-color: #FFFFFF;
}

#settingsTabs QTabBar::tab {
    background-color: #F1F3F5;
    border: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 16px;
    margin-right: 2px;
    color: #6C757D;
}

#settingsTabs QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #1976D2;
    font-weight: bold;
}

/* === Auth Close Button === */
#authCloseBtn {
    background-color: rgba(0, 0, 0, 0.08);
    color: #495057;
    border: none;
    border-radius: 16px;
    font-size: 14px;
    font-weight: bold;
}
#authCloseBtn:hover {
    background-color: #E53935;
    color: #FFFFFF;
}
