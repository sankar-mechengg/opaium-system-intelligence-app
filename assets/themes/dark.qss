/*
 * OP(AI)UM — Dark Theme
 * Deep greys with cyan/teal accents
 */

/* === Global === */
QWidget {
    background-color: #1E1E2E;
    color: #CDD6F4;
    font-family: "Segoe UI", system-ui, sans-serif;
}

QWidget:disabled {
    color: #585B70;
}

/* === Main Central === */
#mainCentral {
    background-color: #1E1E2E;
    border: 1px solid #313244;
    border-radius: 10px;
}

/* === Title Bar === */
#titleBar {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

#titleAppName {
    color: #CDD6F4;
}

#titleTab {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 14px;
    color: #6C7086;
}

#titleTab:checked {
    background-color: #313244;
    color: #89DCEB;
    font-weight: bold;
}

#titleTab:hover:!checked {
    background-color: #262637;
}

#titleSettingsBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #6C7086;
}

#titleSettingsBtn:hover {
    background-color: #313244;
}

#titleMinBtn, #titleMaxBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #6C7086;
}

#titleMinBtn:hover, #titleMaxBtn:hover {
    background-color: #313244;
}

#titleCloseBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #6C7086;
}

#titleCloseBtn:hover {
    background-color: #F38BA8;
    color: #1E1E2E;
}

/* === Search Bar === */
#searchInput {
    background-color: #313244;
    border: 1.5px solid #45475A;
    border-radius: 8px;
    padding: 6px 12px;
    color: #CDD6F4;
    selection-background-color: #45475A;
}

#searchInput:focus {
    border-color: #89DCEB;
}

#typeFilter {
    background-color: #313244;
    border: 1.5px solid #45475A;
    border-radius: 8px;
    padding: 4px 8px;
    color: #CDD6F4;
}

#refreshBtn {
    background-color: #313244;
    border: none;
    border-radius: 8px;
    color: #89DCEB;
    padding: 4px 12px;
    font-weight: bold;
}

#refreshBtn:hover {
    background-color: #45475A;
}

/* === Explorer Splitter === */
#explorerSplitter::handle {
    background-color: #313244;
}

/* === Tree View === */
#treeHeader {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    color: #CDD6F4;
}

#folderTree {
    background-color: #1E1E2E;
    border: none;
    color: #CDD6F4;
}

#folderTree::item {
    padding: 4px 2px;
    border-radius: 4px;
}

#folderTree::item:selected {
    background-color: #313244;
    color: #89DCEB;
}

#folderTree::item:hover:!selected {
    background-color: #262637;
}

/* === Card Grid === */
#cardGridScroll {
    background-color: #1E1E2E;
    border: none;
}

/* === Folder Card === */
#folderCard {
    background-color: #262637;
    border: 1.5px solid #313244;
    border-radius: 10px;
}

#folderCard:hover {
    border-color: #89DCEB;
    background-color: #2A2A3C;
}

#folderCard[selected="true"] {
    border-color: #89DCEB;
    background-color: #313244;
}

#folderCardName {
    color: #CDD6F4;
}

#folderCardCount, #folderCardTime {
    color: #6C7086;
}

#folderCardBroken {
    color: #F38BA8;
}

/* === File Card === */
#fileCard {
    background-color: #262637;
    border: 1.5px solid #313244;
    border-radius: 10px;
}

#fileCard:hover {
    border-color: #A6E3A1;
    background-color: #2A2A3C;
}

#fileCard[selected="true"] {
    border-color: #A6E3A1;
    background-color: #313244;
}

#fileCardName {
    color: #CDD6F4;
}

#fileCardExt {
    color: #89DCEB;
}

#fileCardSize, #fileCardTime {
    color: #6C7086;
}

/* === Collapsible Section === */
#collapsibleHeader {
    background-color: #262637;
    border-radius: 6px;
}

#collapsibleHeader:hover {
    background-color: #313244;
}

#collapsibleTitle {
    color: #BAC2DE;
}

#collapsibleArrow {
    color: #585B70;
}

#collapsibleCount {
    background-color: #313244;
    color: #89DCEB;
    border-radius: 11px;
}

/* === Group Header === */
#groupHeaderTitle {
    color: #BAC2DE;
}

#groupHeaderCount {
    color: #585B70;
}

#groupHeaderArrow {
    color: #45475A;
}

/* === Preview Panel === */
#previewPanel {
    background-color: #181825;
    border-left: 1px solid #313244;
}

#previewHeader {
    color: #CDD6F4;
}

#previewSeparator {
    color: #313244;
}

#previewName {
    color: #CDD6F4;
}

#previewLabel {
    color: #585B70;
}

#previewValue {
    color: #BAC2DE;
}

#previewEmpty {
    color: #45475A;
}

/* === Chat === */
#chatHeader {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    color: #CDD6F4;
}

#chatScroll {
    background-color: #1E1E2E;
}

#bubble_user {
    background-color: #89B4FA;
    border-radius: 14px 14px 4px 14px;
}

#bubbleContent_user {
    color: #1E1E2E;
}

#bubble_assistant {
    background-color: #313244;
    border: 1px solid #45475A;
    border-radius: 14px 14px 14px 4px;
}

#bubbleContent_assistant {
    color: #CDD6F4;
}

#bubble_system {
    background-color: #2A2520;
    border: 1px solid #45403A;
    border-radius: 10px;
}

#bubbleContent_system {
    color: #F9E2AF;
}

#bubbleRole {
    color: #89DCEB;
}

#bubbleTime {
    color: #585B70;
}

/* === Chat Input === */
#chatInput {
    background-color: #313244;
    border: 1.5px solid #45475A;
    border-radius: 10px;
    padding: 8px;
    color: #CDD6F4;
}

#chatInput:focus {
    border-color: #89DCEB;
}

#sendButton {
    background-color: #89B4FA;
    border: none;
    border-radius: 10px;
    color: #1E1E2E;
    font-weight: bold;
}

#sendButton:hover {
    background-color: #B4D0FB;
}

#sendButton:disabled {
    background-color: #45475A;
    color: #585B70;
}

#micButton {
    background-color: #313244;
    border: 1.5px solid #45475A;
    border-radius: 21px;
}

#micButton:hover {
    background-color: #45475A;
}

#micButtonActive {
    background-color: #3A2030;
    border: 2px solid #F38BA8;
    border-radius: 21px;
}

/* === Quick Action Chips === */
#actionChip {
    background-color: #313244;
    border: 1px solid #45475A;
    border-radius: 14px;
    padding: 2px 10px;
    color: #89DCEB;
}

#actionChip:hover {
    background-color: #45475A;
}

/* === Tool Result === */
#toolResult {
    background-color: #1E2A1E;
    border: 1px solid #2A3A2A;
    border-radius: 10px;
    margin: 4px 8px;
}

#toolResultName {
    color: #A6E3A1;
}

#toolResultStatus_ok {
    color: #A6E3A1;
}

#toolResultStatus_err {
    color: #F38BA8;
}

#toolResultMessage {
    color: #BAC2DE;
}

#toolResultSummary {
    color: #6C7086;
}

#toolResultUndoBtn {
    background-color: #2A2520;
    border: 1px solid #45403A;
    border-radius: 6px;
    color: #FAB387;
    padding: 2px 8px;
}

#toolResultUndoBtn:hover {
    background-color: #45403A;
}

/* === Typing Indicator === */
#typingLabel {
    color: #585B70;
}

/* === History === */
#historyTitle {
    color: #CDD6F4;
}

#historyCount {
    color: #585B70;
}

#historyRow {
    background-color: #262637;
    border: 1px solid #313244;
    border-radius: 8px;
}

#historyRow:hover {
    background-color: #2A2A3C;
}

#historyDesc {
    color: #CDD6F4;
}

#historyMeta {
    color: #585B70;
}

#historyUndone {
    color: #585B70;
}

#historyUndoBtn {
    background-color: #2A2520;
    border: 1px solid #45403A;
    border-radius: 6px;
    color: #FAB387;
}

#historyUndoBtn:hover {
    background-color: #45403A;
}

#historyEmpty {
    color: #45475A;
}

/* === Approval Dialog === */
#approvalHeader {
    color: #FAB387;
}

#approvalPreview {
    background-color: #262637;
    border: 1px solid #313244;
    border-radius: 6px;
    color: #CDD6F4;
    font-family: "Cascadia Code", "Consolas", monospace;
}

#approvalWarning {
    color: #FAB387;
}

#approvalRejectBtn {
    background-color: #313244;
    border: 1px solid #45475A;
    border-radius: 8px;
    color: #BAC2DE;
}

#approvalApproveBtn {
    background-color: #A6E3A1;
    border: none;
    border-radius: 8px;
    color: #1E1E2E;
}

#approvalApproveBtn:hover {
    background-color: #B8F0B3;
}

/* === Settings === */
#settingsGroup {
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 12px;
    margin-top: 8px;
}

#settingsGroup::title {
    color: #BAC2DE;
    font-weight: bold;
}

#settingsNote {
    color: #585B70;
}

#settingsError {
    color: #F38BA8;
}

#settingsSaveBtn {
    background-color: #89B4FA;
    border: none;
    border-radius: 8px;
    color: #1E1E2E;
}

#settingsSaveBtn:hover {
    background-color: #B4D0FB;
}

/* === Auth Screen === */
#authAppName {
    color: #CDD6F4;
}

#authSubtitle {
    color: #585B70;
}

#authSeparator {
    color: #313244;
}

#authInstruction {
    color: #BAC2DE;
}

#authInput {
    background-color: #313244;
    border: 2px solid #45475A;
    border-radius: 10px;
    padding: 8px;
    color: #CDD6F4;
}

#authInput:focus {
    border-color: #89DCEB;
}

#authError {
    color: #F38BA8;
}

#authUnlockBtn {
    background-color: #89B4FA;
    border: none;
    border-radius: 10px;
    color: #1E1E2E;
}

#authUnlockBtn:hover {
    background-color: #B4D0FB;
}

#authAttempts {
    color: #585B70;
}

/* === Context Menu === */
#contextMenu {
    background-color: #262637;
    border: 1px solid #45475A;
    border-radius: 8px;
    padding: 4px;
}

#contextMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
    color: #CDD6F4;
}

#contextMenu::item:selected {
    background-color: #313244;
    color: #89DCEB;
}

/* === Scrollbars === */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #45475A;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #585B70;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #45475A;
    border-radius: 4px;
    min-width: 30px;
}

/* === Tooltips === */
QToolTip {
    background-color: #313244;
    color: #CDD6F4;
    border: 1px solid #45475A;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 9pt;
}

/* === Combo Box === */
QComboBox {
    border-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #313244;
    border: 1px solid #45475A;
    border-radius: 4px;
    selection-background-color: #45475A;
    selection-color: #89DCEB;
}

/* === Spin Box === */
QSpinBox {
    background-color: #313244;
    border: 1.5px solid #45475A;
    border-radius: 8px;
    padding: 4px 8px;
    color: #CDD6F4;
}

QSpinBox:focus {
    border-color: #89DCEB;
}

/* === Tab Widget === */
#settingsTabs::pane {
    border: 1px solid #313244;
    border-radius: 8px;
    background-color: #1E1E2E;
}

#settingsTabs QTabBar::tab {
    background-color: #262637;
    border: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 16px;
    margin-right: 2px;
    color: #6C7086;
}

#settingsTabs QTabBar::tab:selected {
    background-color: #1E1E2E;
    color: #89DCEB;
    font-weight: bold;
}
