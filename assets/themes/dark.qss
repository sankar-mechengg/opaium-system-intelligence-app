/*
 * OP(AI)UM — Dark Theme
 * Deep greys with cyan/teal accents
 */

/* === Global === */
QWidget {
    background-color: #1E1E2E;
    color: #CDD6F4;
    font-family: "Segoe UI", system-ui, sans-serif;
}

QWidget:disabled {
    color: #585B70;
}

/* === Main Central === */
#mainCentral {
    background-color: #1E1E2E;
    border: 1px solid #313244;
    border-radius: 10px;
}

/* === Title Bar === */
#titleBar {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

#titleAppName {
    color: #CDD6F4;
}

#titleTab {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 14px;
    color: #6C7086;
}

#titleTab:checked {
    background-color: #313244;
    color: #89DCEB;
    font-weight: bold;
}

#titleTab:hover:!checked {
    background-color: #262637;
}

#titleSettingsBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #6C7086;
}

#titleSettingsBtn:hover {
    background-color: #313244;
}

#titleMinBtn, #titleMaxBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #6C7086;
}

#titleMinBtn:hover, #titleMaxBtn:hover {
    background-color: #313244;
}

#titleCloseBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #6C7086;
}

#titleCloseBtn:hover {
    background-color: #F38BA8;
    color: #1E1E2E;
}

/* === Search Bar === */
#searchInput {
    background-color: #313244;
    border: 1.5px solid #45475A;
    border-radius: 8px;
    padding: 6px 12px;
    color: #CDD6F4;
    selection-background-color: #45475A;
}

#searchInput:focus {
    border-color: #89DCEB;
}

#typeFilter {
    background-color: #313244;
    border: 1.5px solid #45475A;
    border-radius: 8px;
    padding: 4px 8px;
    color: #CDD6F4;
}

#refreshBtn {
    background-color: #313244;
    border: none;
    border-radius: 8px;
    color: #89DCEB;
    padding: 4px 12px;
    font-weight: bold;
}

#refreshBtn:hover {
    background-color: #45475A;
}

/* === Explorer Splitter === */
#explorerSplitter::handle {
    background-color: #313244;
}

/* === Tree View === */
#treeHeader {
    background-color: #181825;
    border: none;
    color: #CDD6F4;
}

#folderTree {
    background-color: #1E1E2E;
    border: none;
    color: #CDD6F4;
}

#folderTree::item {
    padding: 4px 2px;
    border-radius: 4px;
}

#folderTree::item:selected {
    background-color: #313244;
    color: #89DCEB;
}

#folderTree::item:hover:!selected {
    background-color: #262637;
}

/* === Card Grid === */
#cardGridScroll {
    background-color: #1E1E2E;
    border: none;
}

/* === Folder Card === */
#folderCard {
    background-color: #262637;
    border: none;
    border-radius: 10px;
}

#folderCard:hover {
    background-color: #2A2A3C;
}

#folderCard[selected="true"] {
    background-color: #313244;
}

#folderCardName {
    color: #CDD6F4;
}

#folderCardCount, #folderCardTime {
    color: #6C7086;
}

#folderCardBroken {
    color: #F38BA8;
}

/* === File Card === */
#fileCard {
    background-color: #262637;
    border: none;
    border-radius: 10px;
}

#fileCard:hover {
    background-color: #2A2A3C;
}

#fileCard[selected="true"] {
    background-color: #313244;
}

#fileCardName {
    color: #CDD6F4;
}

#fileCardExt {
    color: #89DCEB;
}

#fileCardSize, #fileCardTime {
    color: #6C7086;
}

/* === Collapsible Section === */
#collapsibleHeader {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

#collapsibleHeader:hover {
    background-color: #262637;
}

#collapsibleTitle {
    color: #BAC2DE;
}

#collapsibleArrow {
    color: #585B70;
}

#collapsibleCount {
    background-color: #313244;
    color: #89DCEB;
    border-radius: 11px;
}

/* === Group Header === */
#groupHeaderTitle {
    color: #BAC2DE;
}

#groupHeaderCount {
    color: #585B70;
}

#groupHeaderArrow {
    color: #45475A;
}

/* === Preview Panel === */
#previewPanel {
    background-color: #181825;
    border-left: 1px solid #313244;
}

#previewHeader {
    color: #CDD6F4;
}

#previewSeparator {
    color: #313244;
}

#previewName {
    color: #CDD6F4;
}

#previewLabel {
    color: #585B70;
}

#previewValue {
    color: #BAC2DE;
}

#previewEmpty {
    color: #45475A;
}

/* === Chat === */
#chatHeader {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    color: #CDD6F4;
}

#chatScroll {
    background-color: #1E1E2E;
}

#bubble_user {
    background-color: rgba(137, 180, 250, 0.15);
    border: 1px solid rgba(137, 180, 250, 0.35);
    border-radius: 14px 14px 4px 14px;
    padding: 4px;
    min-width: 80px;
}

#bubbleContent_user {
    color: #B4D0FB;
    background: transparent;
}

#bubble_assistant {
    background-color: #313244;
    border: 1px solid #45475A;
    border-radius: 14px 14px 14px 4px;
    padding: 4px;
    min-width: 80px;
}

#bubbleContent_assistant {
    color: #CDD6F4;
    background: transparent;
}

#bubble_system {
    background-color: rgba(249, 226, 175, 0.1);
    border: 1px solid rgba(249, 226, 175, 0.25);
    border-radius: 10px;
    padding: 4px;
}

#bubbleContent_system {
    color: #F9E2AF;
    background: transparent;
}

#bubbleRole {
    color: #89DCEB;
    background: transparent;
}

#bubbleTime_assistant, #bubbleTime_system {
    color: #585B70;
    background: transparent;
}

#bubbleTime_user {
    color: rgba(137, 180, 250, 0.5);
    background: transparent;
}

/* === Chat Context Card === */
#chatContextCard {
    background: transparent;
}

#contextCardInner {
    background-color: rgba(137, 180, 250, 0.08);
    border: 1px solid rgba(137, 180, 250, 0.2);
    border-radius: 8px;
    padding: 2px;
}

#contextCardName {
    color: #CDD6F4;
    background: transparent;
}

#contextCardPath {
    color: #6C7086;
    background: transparent;
}

#contextCardType {
    color: #89B4FA;
    background-color: rgba(137, 180, 250, 0.12);
    border-radius: 4px;
    padding: 2px 6px;
}

#contextCardIcon {
    background: transparent;
}

/* === Conversations Sidebar === */
#convSidebar {
    background-color: #181825;
    border-right: 1px solid #313244;
}

#convSidebarHeader {
    background-color: #181825;
    border-bottom: 1px solid #313244;
}

#convSidebarTitle {
    color: #CDD6F4;
}

#convNewBtn {
    background-color: #313244;
    border: none;
    border-radius: 14px;
    color: #89DCEB;
}

#convNewBtn:hover {
    background-color: #45475A;
}

#convSidebarScroll {
    background-color: #181825;
}

#convItem {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 2px;
}

#convItem:hover {
    background-color: #262637;
}

#convItem[selected="true"] {
    background-color: #313244;
}

#convItemTitle {
    color: #CDD6F4;
    background: transparent;
}

#convItemFolder {
    color: #6C7086;
    background: transparent;
}

#convItemTime {
    color: #585B70;
    background: transparent;
}

#convEmptyLabel {
    color: #45475A;
}

#convSeparator {
    color: #313244;
}

/* === Markdown Browser === */
#markdownBrowser {
    background: transparent;
    border: none;
    color: #CDD6F4;
}

/* === Chat Input === */
#chatInput {
    background-color: #313244;
    border: 1.5px solid #45475A;
    border-radius: 10px;
    padding: 8px;
    color: #CDD6F4;
}

#chatInput:focus {
    border-color: #89DCEB;
}

#sendButton {
    background-color: #89B4FA;
    border: none;
    border-radius: 10px;
    color: #1E1E2E;
    font-weight: bold;
}

#sendButton:hover {
    background-color: #B4D0FB;
}

#sendButton:disabled {
    background-color: #45475A;
    color: #585B70;
}

#micButton {
    background-color: #313244;
    border: 1.5px solid #45475A;
    border-radius: 21px;
}

#micButton:hover {
    background-color: #45475A;
}

#micButtonActive {
    background-color: #3A2030;
    border: 2px solid #F38BA8;
    border-radius: 21px;
}

/* === Quick Action Chips === */
#actionChip {
    background-color: #313244;
    border: 1px solid #45475A;
    border-radius: 14px;
    padding: 2px 10px;
    color: #89DCEB;
}

#actionChip:hover {
    background-color: #45475A;
}

/* === Tool Result === */
#toolResult {
    background-color: #1E2A1E;
    border: 1px solid #2A3A2A;
    border-radius: 10px;
    margin: 4px 8px;
}

#toolResultName {
    color: #A6E3A1;
}

#toolResultStatus_ok {
    color: #A6E3A1;
}

#toolResultStatus_err {
    color: #F38BA8;
}

#toolResultMessage {
    color: #BAC2DE;
}

#toolResultSummary {
    color: #6C7086;
}

#toolResultUndoBtn {
    background-color: #2A2520;
    border: 1px solid #45403A;
    border-radius: 6px;
    color: #FAB387;
    padding: 2px 8px;
}

#toolResultUndoBtn:hover {
    background-color: #45403A;
}

/* === Typing Indicator === */
#typingLabel {
    color: #585B70;
}

/* === History === */
#historyTitle {
    color: #CDD6F4;
}

#historyCount {
    color: #585B70;
}

#historyRow {
    background-color: #262637;
    border: 1px solid #313244;
    border-radius: 8px;
}

#historyRow:hover {
    background-color: #2A2A3C;
}

#historyDesc {
    color: #CDD6F4;
}

#historyMeta {
    color: #585B70;
}

#historyUndone {
    color: #585B70;
}

#historyUndoBtn {
    background-color: #2A2520;
    border: 1px solid #45403A;
    border-radius: 6px;
    color: #FAB387;
}

#historyUndoBtn:hover {
    background-color: #45403A;
}

#historyClearBtn {
    background-color: #45475A;
    border: none;
    border-radius: 6px;
    color: #F38BA8;
    padding: 2px 10px;
}

#historyClearBtn:hover {
    background-color: #F38BA8;
    color: #1E1E2E;
}

#historyDeleteBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #585B70;
    font-size: 10px;
}

#historyDeleteBtn:hover {
    background-color: #F38BA8;
    color: #1E1E2E;
}

#historyEmpty {
    color: #45475A;
}

/* === Approval Dialog === */
#approvalHeader {
    color: #FAB387;
}

#approvalPreview {
    background-color: #262637;
    border: 1px solid #313244;
    border-radius: 6px;
    color: #CDD6F4;
    font-family: "Cascadia Code", "Consolas", monospace;
}

#approvalWarning {
    color: #FAB387;
}

#approvalRejectBtn {
    background-color: #313244;
    border: 1px solid #45475A;
    border-radius: 8px;
    color: #BAC2DE;
}

#approvalApproveBtn {
    background-color: #A6E3A1;
    border: none;
    border-radius: 8px;
    color: #1E1E2E;
}

#approvalApproveBtn:hover {
    background-color: #B8F0B3;
}

/* === Settings === */
#settingsGroup {
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 12px;
    margin-top: 8px;
}

#settingsGroup::title {
    color: #BAC2DE;
    font-weight: bold;
}

#settingsNote {
    color: #585B70;
}

#settingsError {
    color: #F38BA8;
}

#settingsSaveBtn {
    background-color: #89B4FA;
    border: none;
    border-radius: 8px;
    color: #1E1E2E;
}

#settingsSaveBtn:hover {
    background-color: #B4D0FB;
}

/* === Auth Screen === */
#authAppName {
    color: #CDD6F4;
}

#authSubtitle {
    color: #585B70;
}

#setupFullName {
    color: #6C7086;
}

#authSeparator {
    color: #313244;
}

#authInstruction {
    color: #BAC2DE;
}

#authInput {
    background-color: #313244;
    border: 2px solid #45475A;
    border-radius: 10px;
    padding: 8px;
    color: #CDD6F4;
}

#authInput:focus {
    border-color: #89DCEB;
}

#authError {
    color: #F38BA8;
}

#authUnlockBtn {
    background-color: #89B4FA;
    border: none;
    border-radius: 10px;
    color: #1E1E2E;
}

#authUnlockBtn:hover {
    background-color: #B4D0FB;
}

#authAttempts {
    color: #585B70;
}

/* === Context Menu === */
#contextMenu {
    background-color: #262637;
    border: 1px solid #45475A;
    border-radius: 8px;
    padding: 4px;
}

#contextMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
    color: #CDD6F4;
}

#contextMenu::item:selected {
    background-color: #313244;
    color: #89DCEB;
}

/* === Scrollbars === */
QScrollBar:vertical {
    background: #1E1E2E;
    width: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #585B70;
    border-radius: 6px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: #89B4FA;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1E1E2E;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #585B70;
    border-radius: 6px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: #89B4FA;
}

/* === Tooltips === */
QToolTip {
    background-color: #313244;
    color: #CDD6F4;
    border: 1px solid #45475A;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 9pt;
}

/* === Combo Box === */
QComboBox {
    border-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #313244;
    border: 1px solid #45475A;
    border-radius: 4px;
    selection-background-color: #45475A;
    selection-color: #89DCEB;
}

/* === Spin Box === */
QSpinBox {
    background-color: #313244;
    border: 1.5px solid #45475A;
    border-radius: 8px;
    padding: 4px 8px;
    color: #CDD6F4;
}

QSpinBox:focus {
    border-color: #89DCEB;
}

/* === Tab Widget === */
#settingsTabs::pane {
    border: 1px solid #313244;
    border-radius: 8px;
    background-color: #1E1E2E;
}

#settingsTabs QTabBar::tab {
    background-color: #262637;
    border: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 16px;
    margin-right: 2px;
    color: #6C7086;
}

#settingsTabs QTabBar::tab:selected {
    background-color: #1E1E2E;
    color: #89DCEB;
    font-weight: bold;
}

/* === Auth Close Button === */
#authCloseBtn {
    background-color: rgba(69, 71, 90, 0.6);
    color: #CDD6F4;
    border: none;
    border-radius: 16px;
    font-size: 14px;
    font-weight: bold;
}
#authCloseBtn:hover {
    background-color: #F38BA8;
    color: #1E1E2E;
}
